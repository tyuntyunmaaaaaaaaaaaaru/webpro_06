<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>京葉線の駅</title>
</head>
<body>
  <h2>京葉線の駅の詳細</h2>
  <table border="1">
    <tr><th>ID</th><th>駅コード</th><th>駅名</th></tr>
      <% for( let row of data ) { %>
        <tr><td><%= row.id %></td>
        <td><%= row.code %></td>
        <td><%= row.name %></td></tr>
      <% } %>
  </table>
  <p><a href="/public/keiyo_add.html" style="display:inline-block;padding:8px 18px;background:#1976d2;color:#fff;text-decoration:none;border-radius:6px;">＋ 追加する</a></p>
</body>
</html>
