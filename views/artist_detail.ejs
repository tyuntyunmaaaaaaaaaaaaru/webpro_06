<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の紹介</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>

    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>アーティスト名</td><td><%= data.name %></td></tr>

    <tr><td>活動地域</td><td><%= data.region %></td></tr>

    <tr><td>代表曲</td><td><%= data.song %></td></tr>
  </table>
  <a href="/music">ジャンル一覧に戻る</a>

</body>
</html>
