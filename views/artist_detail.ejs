<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の紹介</h2>
  <p><%= data.intro %></p>

  <table>
    <tr><th>ID</th><th>代表曲</th></tr>
    <% for( let row of songs ) { %>
      <tr><td><%= row.id %></td>
      <td><a href="<%= row.url %>"><%= row.title %></a></td></tr>
    <% } %>
  </table>
  <a href="/music">ジャンル一覧に戻る</a>

</body>
</html>
