<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>ラーメン店リスト</title>
</head>
<body>
  <h2>好きなラーメン店</h2>
  <table border="1">
    <tr><th>ID</th><th>店名</th><th>エリア</th><th>タイプ</th></tr>
      <% for( let row of data ) { %>
        <tr><td><%= row.id %></td>
        <td><%= row.name %></td>
        <td><%= row.area %></td>
        <td><%= row.type %></td></tr>
      <% } %>
  </table>
  <p><a href="/public/ramen_add.html" style="display:inline-block;padding:8px 18px;background:#1976d2;color:#fff;text-decoration:none;border-radius:6px;">＋ 追加する</a></p>
</body>
</html>
