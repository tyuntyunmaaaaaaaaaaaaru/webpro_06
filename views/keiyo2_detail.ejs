<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table border="1">
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>駅コード</td><td><%= data.code %></td></tr>
    <tr><td>駅名</td><td><%= data.name %></td></tr>
    <tr><td>乗り換え線</td><td><%= data.change %></td></tr>
    <tr><td>1日の乗客数</td><td><%= data.passengers %></td></tr>
    <tr><td>東京駅からの距離(km)</td><td><%= data.distance %></td></tr>
  </table>
  <p>
    <a href="/keiyo2_edit/<%= number %>">この駅を変更する</a> /
    <a href="/keiyo2_delete/<%= number %>" onclick="return confirm('削除しますか？')">この駅を削除する</a>
  </p>
  <a href="/keiyo2">駅一覧に戻る</a>
</body>
</html>
