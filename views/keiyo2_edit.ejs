<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %>の変更</title>
</head>
<body>
  <h2><%= data.name %>の情報を変更</h2>
  <form action="/keiyo2_update/<%= number %>" method="get">
    <p>駅コード（必須）: <input type="text" name="code" value="<%= data.code %>"></p>
    <p>駅名（必須）: <input type="text" name="name" value="<%= data.name %>"></p>
    <p>乗り換え線: <input type="text" name="change" value="<%= data.change %>"></p>
    <p>1日の乗客数: <input type="number" name="passengers" value="<%= data.passengers %>"></p>
    <p>東京駅からの距離(km): <input type="number" step="0.1" name="distance" value="<%= data.distance %>"></p>
    <p><input type="submit" value="変更する"></p>
  </form>
  <a href="/keiyo2/<%= number %>">詳細に戻る</a>
</body>
</html>
